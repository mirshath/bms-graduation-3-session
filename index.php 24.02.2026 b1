<script>
    document.getElementById('phone_no').addEventListener('input', function (e) {
        var phoneInput = this.value;
        var errorElement = document.getElementById('phone-error');

        // Allow only numbers, and remove non-numeric characters
        this.value = this.value.replace(/[^0-9]/g, '');

        // Check if the input contains any non-numeric characters (for further validation if needed)
        if (/[^0-9]/.test(phoneInput)) {
            errorElement.style.display = 'block';
        } else {
            errorElement.style.display = 'none';
        }
    });

    // Calling Name validation - letters, spaces, hyphens, and common accents only
    document.getElementById('calling_name').addEventListener('input', function (e) {
        var callingName = this.value.trim();
        var alertEl = document.getElementById('calling_name_alert');
        // Allow letters (including Unicode), spaces, hyphens, apostrophes
        if (callingName.length > 0 && !/^[\p{L}\s\-'.]+$/u.test(callingName)) {
            alertEl.style.display = 'block';
        } else {
            alertEl.style.display = 'none';
        }
    });
    document.getElementById('calling_name').addEventListener('blur', function () {
        var callingName = this.value.trim();
        var alertEl = document.getElementById('calling_name_alert');
        if (callingName.length > 0 && !/^[\p{L}\s\-'.]+$/u.test(callingName)) {
            alertEl.style.display = 'block';
        } else {
            alertEl.style.display = 'none';
        }
    });
</script>

