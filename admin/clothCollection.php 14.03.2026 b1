            //         } else {
            //             alert('Failed to mark as collected.');
            //             btn.prop('disabled', false).html('<i class="fas fa-check-circle me-2"></i>Mark as Collected');
            //         }
            //     },
            //     error: function() {
            //         alert('An error occurred. Please try again.');
            //         btn.prop('disabled', false).html('<i class="fas fa-check-circle me-2"></i>Mark as Collected');
            //     }
            // }); 



            // $.ajax({
