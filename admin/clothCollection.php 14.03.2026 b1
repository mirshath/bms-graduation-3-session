<script>
    $(document).ready(function() {
        let currentStudentID = '';

        // Function to reset form and focus input
        function resetForm() {
            $('#studentIDForm')[0].reset();
            $('#studentID').focus();
            currentStudentID = '';
        }

        // Function to format items display
        function formatItems(itemsString) {
            if (!itemsString || itemsString === 'None') {
                return '<div class="alert alert-info text-center mb-0"><i class="fas fa-info-circle me-2"></i>No items assigned</div>';
            }

            const items = itemsString.split(',').map(item => item.trim());
            const itemIcons = {
                'Cloak': 'fas fa-tshirt',
                'Slashes': 'fas fa-scarf',
                'Hats': 'fas fa-hat-wizard'
            };

            let html = '<div class="mt-3"><h5 class="mb-3 fw-bold text-gray-700">Items to Collect</h5>';
            html += '<div class="row g-3">';
            items.forEach(function(item) {
                const icon = itemIcons[item] || 'fas fa-box';
                html += `
                    <div class="col-4">
                        <div class="item-card">
                            <div class="item-info">
                                <div class="item-icon">
                                    <i class="${icon}"></i>
                                </div>
                                <div>
                                    <p class="item-name">${item}</p>
                                    </div>
                                    </div>
                                    </div>
                                    </div>
                                    `;
            });
            html += '</div></div>';
            return html;
        }
        // <p class="item-status">Ready for Collection</p>

        // Handle student ID form submit
        $('#studentIDForm').on('submit', function(e) {
            e.preventDefault();
            let studentID = $('#studentID').val().trim();
            if (!studentID) return;

            currentStudentID = studentID;

            $.ajax({
                url: 'checkStudentCloth.php',
                type: 'POST',
                data: {
                    studentID: studentID
                },
                dataType: 'json',
                success: function(response) {
                    if (response.status === 'found') {
                        // Student Info Card
                        let studentHtml = `
                            <div class="student-info-card">
                                <div class="student-info-item">
                                    <span class="student-info-label">Student ID:</span>
                                    <span class="student-info-value">${response.student_id}</span>
                                </div>
                                <div class="student-info-item">
                                    <span class="student-info-label">Name:</span>
                                    <span class="student-info-value">${response.student_name}</span>
                                </div>
                                <div class="student-info-item">
                                    <span class="student-info-label">Program:</span>
                                    <span class="student-info-value">${response.program}</span>
                                </div>
                            </div>
                        `;
                        $('#studentInfo').html(studentHtml);
                        $('#itemsList').html(formatItems(response.items));
                        $('#successModal').modal('show');
                    } else if (response.status === 'collected') {
                        // Student Info Card
                        let attendedHtml = `
                            <div class="student-info-card">
                                <div class="student-info-item">
                                    <span class="student-info-label">Student ID:</span>
                                    <span class="student-info-value">${response.student_id}</span>
                                </div>
                                <div class="student-info-item">
                                    <span class="student-info-label">Name:</span>
                                    <span class="student-info-value">${response.student_name}</span>
                                </div>
                                <div class="student-info-item">
                                    <span class="student-info-label">Program:</span>
                                    <span class="student-info-value">${response.program}</span>
                                </div>
                            </div>
                        `;
                        $('#attendedInfo').html(attendedHtml);
                        $('#attendedItemsList').html(formatItems(response.items));
                        $('#attendedModal').modal('show');
                    } else if (response.status === 'not_registered') {
                        $('#notRegisteredModal').modal('show');
                    } else if (response.status === 'not_paid') {
                        $('#notPaidModal').modal('show');
                    } else {
                        $('#errorModal').modal('show');
                    }
                },
                error: function() {
                    alert('An error occurred. Please try again.');
                }
            });
        });

        // Handle mark as collected button click
        $('#attendedBtn').on('click', function() {
            let btn = $(this);
            let studentID = currentStudentID || $('#studentID').val().trim();

            if (!studentID) {
                alert('Student ID is required!');
                return;
            }

            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Processing...');

            // $.ajax({
            //     url: 'markClothAttended.php',
            //     type: 'POST',
            //     data: {
            //         studentID: studentID
            //     },
            //     dataType: 'json',
            //     success: function(response) {
            //         if (response.status === 'success') {
