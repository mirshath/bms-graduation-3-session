        // Generate PDF
        // ------------------------------

        // ---------- old 23.02.2026 b1 ----------
        html2canvas(offerLetterElement, {
            scale: window.devicePixelRatio || 3, // higher scale for crispness
            useCORS: true, // allow cross-origin images
            allowTaint: false, // false for security, avoid tainted images
            backgroundColor: '#ffffff',
            logging: false // optional, set true for debugging
        }).then(function(canvas) {
            const {
                jsPDF
            } = window.jspdf;

            const pdf = new jsPDF('p', 'mm', 'a4');
            const pageWidth = pdf.internal.pageSize.getWidth();
            const pageHeight = pdf.internal.pageSize.getHeight();

            const margin = 4; // small margin
            const imgWidth = pageWidth - margin * 2;
            const imgHeight = (canvas.height * imgWidth) / canvas.width;

            let heightLeft = imgHeight;
            let position = margin;

            const imgData = canvas.toDataURL('image/jpeg', 1.0);

            // First page
            pdf.addImage(imgData, 'JPEG', margin, position, imgWidth, imgHeight);
            heightLeft -= pageHeight - margin * 2;

            // Additional pages if content exceeds one page
            while (heightLeft > 0) {
                pdf.addPage();
                position = -(imgHeight - heightLeft + margin);
                pdf.addImage(imgData, 'JPEG', margin, position, imgWidth, imgHeight);
                heightLeft -= pageHeight - margin * 2;
            }

            // Prepare PDF for sending
            const pdfBase64 = pdf.output('datauristring').split(',')[1];
            const cleanName = studentData.full_name.replace(/[^a-zA-Z0-9]/g, '_');
            const pdfFilename = `BMS_Receipt_${cleanName}_${studentData.receipt_number}.pdf`;



            // Send to server
            $.ajax({
                url: 'send_offer_letter_email.php',
                type: 'POST',
                data: {
                    ...studentData,
                    pdf_data: pdfBase64,
                    pdf_name: pdfFilename
                },
                dataType: 'json',
                success: function(res) {
                    if (res.success) {
                        alert('✅ Payment successful! Receipt has been sent to ' + studentData.university_email);
                        location.reload();
                    } else {
                        alert('❌ Failed: ' + (res.message || 'Unknown error'));
                        // include the after error refresh to avoid the error refresh
                        location.reload();
                    }
                },
                error: function(xhr, status, error) {
                    console.error("AJAX Error:", error, xhr.responseText);
                    alert('❌ Failed to send email. Please try again or contact support.');
                    // include the after error refresh to avoid the error refresh
                    location.reload();
                },
                complete: function() {
                    button.prop('disabled', false).html('<i class="fas fa-envelope"></i> Payment Process');
                }
            });
        }).catch(function(error) {
            console.error('PDF Generation Error:', error);
            alert('❌ Failed to generate PDF: ' + error.message);
            button.prop('disabled', false).html('<i class="fas fa-envelope"></i> Payment Process');
        });

    });
</script>




