<script>
    // Function to check student ID
    function checkStudentID() {
        var student_id = $('#studentID').val();

        $.ajax({
            url: 'student_id_check.php',
            method: 'POST',
            data: {
                student_id: student_id
            },
            success: function(response) {
                $('#result').html(response);
                // After updating attendance, fetch attended users in real-time
                fetchAttendedUsers();
            }
        });
    }
    // Function to fetch attended users
    function fetchAttendedUsers() {
        $.ajax({
            url: 'fetch_attended_users.php',
            method: 'GET',
            success: function(response) {
                $('#attendedUsers').html(response);
                // Initialize DataTable after the table is populated
                $('#attendedStudentsTable').DataTable();
            }
        });
    }

    // Fetch attended users on page load
    $(document).ready(function() {
        $('#studentID').focus();
        fetchAttendedUsers();
    });
</script>


