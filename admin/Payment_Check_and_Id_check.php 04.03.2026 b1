        if (!studentData.university_email) {
            alert('Student email not found.');
            button.prop('disabled', false).html('<i class="fas fa-envelope"></i> Payment Process');
            return;
        }

        // ------------------------------
        // Generate PDF
        // ------------------------------


        // ---------- old 23.02.2026 b1 ----------
        html2canvas(offerLetterElement, {
            scale: window.devicePixelRatio || 3, // higher scale for crispness
            useCORS: true, // allow cross-origin images
            allowTaint: false, // false for security, avoid tainted images
            backgroundColor: '#ffffff',
            logging: false // optional, set true for debugging
        }).then(function (canvas) {
            const {
                jsPDF
            } = window.jspdf;

            const pdf = new jsPDF('p', 'mm', 'a4');
            const pageWidth = pdf.internal.pageSize.getWidth();
            const pageHeight = pdf.internal.pageSize.getHeight();

            const margin = 4; // small margin
            const imgWidth = pageWidth - margin * 2;
            const imgHeight = (canvas.height * imgWidth) / canvas.width;

            let heightLeft = imgHeight;
            let position = margin;

            const imgData = canvas.toDataURL('image/jpeg', 1.0);

            // First page
            pdf.addImage(imgData, 'JPEG', margin, position, imgWidth, imgHeight);
            heightLeft -= pageHeight - margin * 2;

            // Additional pages if content exceeds one page
            while (heightLeft > 0) {
