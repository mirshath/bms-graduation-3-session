<?php
include("../database/connection.php");

$studentID = trim($_POST['studentID'] ?? '');
if ($studentID === '') {
    echo json_encode(["status" => "error", "message" => "No ID provided"]);
    exit;
}

// Fetch student info from bulk_data_table as primary, and join others
$sql = "
    SELECT 
        b.student_id, 
        b.calling_name, 
        b.seat_no, 
        b.program_name, 
        b.session_time,
        r.name_in_full, 
        r.attend, 
        r.graduation_payment_status,
        osd.in_no
    FROM bulk_data_table b
    LEFT JOIN registered_students r ON b.student_id = r.student_id
    LEFT JOIN old_student_db osd ON b.student_id = osd.student_id
    WHERE b.student_id = ?
";
$stmt = $conn->prepare($sql);
$stmt->bind_param("s", $studentID);
$stmt->execute();
$result = $stmt->get_result();

if ($result->num_rows > 0) {
    $row = $result->fetch_assoc();
    
    // Use calling_name from bulk_data_table if name_in_full is not available
    $displayName = !empty($row['name_in_full']) ? $row['name_in_full'] : $row['calling_name'];

    // Check if student already attended
    if (!empty($row['attend']) && $row['attend'] === 'attended') {
        echo json_encode([
            "status" => "attended",
            "data" => [
                "student_id" => $row['student_id'],
                "full_name" => $displayName,
                "program_name" => $row['program_name'],
                "attend" => $row['attend'],
                "seat_no" => $row['seat_no'] ?? 'N/A',
                "in_no" => $row['in_no'] ?? 'N/A',
                "session" => $row['session_time'] ?? 'N/A',
                "graduation_payment_status" => $row['graduation_payment_status'] ?? 'N/A'
            ]
        ]);
    } else {
        echo json_encode([
            "status" => "success",
            "data" => [
                "student_id" => $row['student_id'],
                "full_name" => $displayName,
                "program_name" => $row['program_name'],
                "seat_no" => $row['seat_no'] ?? 'N/A',
                "in_no" => $row['in_no'] ?? 'N/A',
                "session" => $row['session_time'] ?? 'N/A',
                "graduation_payment_status" => $row['graduation_payment_status'] ?? 'N/A'
            ]
        ]);
    }
} else {
    echo json_encode(["status" => "error", "message" => "Student not found"]);
}

$stmt->close();
$conn->close();
