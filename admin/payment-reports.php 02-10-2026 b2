<?php
session_start();
date_default_timezone_set('Asia/Colombo');
if (!isset($_SESSION['admin_id'])) {
    header("Location: login");
    exit();
}
include("../database/connection.php");

// payment_date (TIMESTAMP, UTC) and added_on (DATETIME, Colombo) must be read on one clock.
mysqli_query($conn, "SET time_zone = '+05:30'");

/* ---------- Inputs ---------- */
$views = ['ledger' => 'Ledger', 'day' => 'By day', 'month' => 'By month', 'program' => 'By program', 'student' => 'By student'];
$view = isset($views[$_GET['view'] ?? '']) ? $_GET['view'] : 'ledger';
$isDate = fn($d) => is_string($d) && preg_match('/^\d{4}-\d{2}-\d{2}$/', $d);
$num = fn($v) => (isset($v) && is_numeric($v) && $v >= 0) ? (string) (float) $v : '';
$pick = fn($v, array $ok) => in_array($v, $ok, true) ? $v : '';

$f = [
    'date_from' => $isDate($_GET['date_from'] ?? null) ? $_GET['date_from'] : date('Y-m-01'),
    'date_to'   => $isDate($_GET['date_to'] ?? null) ? $_GET['date_to'] : date('Y-m-d'),
    'program'   => trim($_GET['program'] ?? ''),
    'session'   => trim($_GET['session'] ?? ''),
    'search'    => trim($_GET['search'] ?? ''),
    'type'      => $pick($_GET['type'] ?? '', ['payment', 'extra']),
    'cashier'   => trim($_GET['cashier'] ?? ''),
    'min'       => $num($_GET['min'] ?? null),
    'max'       => $num($_GET['max'] ?? null),
    'tickets'   => $pick($_GET['tickets'] ?? '', ['none', 'any', '1-2', '3-5', '6+']),
    'sort'      => $pick($_GET['sort'] ?? '', ['date_asc', 'amount_desc', 'amount_asc', 'student']),
];
$sorts = ['' => 'ts DESC', 'date_asc' => 'ts ASC', 'amount_desc' => '(grad + extra) DESC', 'amount_asc' => '(grad + extra) ASC', 'student' => 'student_id ASC, ts DESC'];

/* ---------- The ledger: every rupee received, one row each ----------
   payment_records  = graduation fee + extra tickets bought at the desk (has a receipt)
   extra_ticket_log = extra tickets added later (no receipt, no graduation fee)  */
$ledger = "
    SELECT p.payment_date AS ts, 'payment' AS kind, p.student_id, COALESCE(r.name_in_full, o.name, '') AS student,
           p.program_name AS program, d.session AS sess, p.receipt_number AS ref, p.graduation_fee AS grad,
           p.extra_ticket_fee AS extra, p.extra_ticket_count AS tickets, p.created_by AS cashier
    FROM payment_records p
    LEFT JOIN registered_students r ON r.student_id = p.student_id
    LEFT JOIN old_student_db o ON o.student_id = p.student_id
    LEFT JOIN data_tables d ON d.programName = p.program_name
    UNION ALL
    SELECT e.added_on, 'extra', e.student_id, COALESCE(e.student_name, ''), e.program_name, e.session,
           NULL, 0, e.total_added, e.added_tickets, e.added_by
    FROM extra_ticket_log e";

/* Every filter is applied to every ledger row, so the totals, tables and CSV always agree. */
$w = ["DATE(ts) BETWEEN ? AND ?"];
$P = [$f['date_from'], $f['date_to']];
foreach (['program' => 'program', 'session' => 'sess', 'type' => 'kind', 'cashier' => 'cashier'] as $k => $col) {
    if ($f[$k] !== '') {
        $w[] = "$col = ?";
        $P[] = $f[$k];
    }
}
if ($f['min'] !== '') {
    $w[] = "(grad + extra) >= ?";
    $P[] = $f['min'];
}
if ($f['max'] !== '') {
    $w[] = "(grad + extra) <= ?";
    $P[] = $f['max'];
}
$w[] = [
    '' => '1=1',
    'none' => 'tickets = 0',
    'any' => 'tickets > 0',
    '1-2' => 'tickets BETWEEN 1 AND 2',
    '3-5' => 'tickets BETWEEN 3 AND 5',
    '6+' => 'tickets >= 6'
][$f['tickets']];
if ($f['search'] !== '') {
    $w[] = "(student_id LIKE ? OR student LIKE ? OR ref LIKE ?)";
    array_push($P, "%{$f['search']}%", "%{$f['search']}%", "%{$f['search']}%");
}
$filtered = "SELECT * FROM ($ledger) l WHERE " . implode(' AND ', $w);

function rows(mysqli $c, string $sql, array $p = []): array
{
    $st = $c->prepare($sql);
    if ($p) {
        $st->bind_param(str_repeat('s', count($p)), ...$p);
    }
    $st->execute();
    return $st->get_result()->fetch_all(MYSQLI_ASSOC);
}

/* ---------- Data ---------- */
$key = ['day' => 'DATE(ts)', 'month' => "DATE_FORMAT(ts, '%Y-%m')", 'program' => 'program', 'student' => 'student_id'];
if ($view === 'ledger') {
    $data = rows($conn, "SELECT * FROM ($filtered) x ORDER BY {$sorts[$f['sort']]}", $P);
} else {
    $ord = in_array($view, ['program', 'student']) ? 'revenue DESC' : 'k DESC';
    $data = rows($conn, "SELECT {$key[$view]} AS k, MAX(student) AS name, MAX(program) AS prog, SUM(kind='payment') AS payments,
            SUM(grad) AS grad, SUM(extra) AS extra, SUM(tickets) AS tickets, SUM(grad + extra) AS revenue
         FROM ($filtered) x GROUP BY k ORDER BY $ord", $P);
}

if (isset($_GET['export'])) {
    header('Content-Type: text/csv; charset=utf-8');
    header('Content-Disposition: attachment; filename="payments_' . $view . '_' . date('Ymd_His') . '.csv"');
    $o = fopen('php://output', 'w');
    fwrite($o, "\xEF\xBB\xBF");
    fputcsv($o, ['BMS Graduation payment report', "{$f['date_from']} to {$f['date_to']}", 'Generated ' . date('d M Y H:i')]);
    if ($view === 'ledger') {
        fputcsv($o, ['Date', 'Entry', 'Receipt', 'Student ID', 'Student', 'Program', 'Session', 'Tickets', 'Graduation fee', 'Extra tickets', 'Total', 'Taken by']);
        foreach ($data as $d) {
            fputcsv($o, [
                $d['ts'],
                $d['kind'] === 'payment' ? 'Payment' : 'Extra tickets',
                $d['ref'],
                $d['student_id'],
                $d['student'],
                $d['program'],
                $d['sess'],
                $d['tickets'],
                $d['grad'],
                $d['extra'],
                $d['grad'] + $d['extra'],
                $d['cashier']
            ]);
        }
    } else {
        fputcsv($o, [$views[$view], 'Name', 'Payments', 'Graduation fee', 'Extra tickets', 'Tickets', 'Revenue']);
        foreach ($data as $d) {
            fputcsv($o, [$d['k'], $view === 'student' ? $d['name'] : '', $d['payments'], $d['grad'], $d['extra'], $d['tickets'], $d['revenue']]);
        }
    }
    exit();
}

$s = rows($conn, "SELECT SUM(kind='payment') AS payments, COUNT(DISTINCT student_id) AS students, COALESCE(SUM(grad),0) AS grad,
        COALESCE(SUM(CASE WHEN kind='payment' THEN extra END),0) AS desk, COALESCE(SUM(CASE WHEN kind='extra' THEN extra END),0) AS later,
        COALESCE(SUM(tickets),0) AS tickets FROM ($filtered) x", $P)[0];
$rev = $s['grad'] + $s['desk'] + $s['later'];
$pct = fn($n) => $rev > 0 ? number_format($n / $rev * 100, 1) . '%' : '–';
$avg = $s['students'] > 0 ? $rev / $s['students'] : 0;

$programs = rows($conn, "SELECT programName FROM data_tables ORDER BY programName");
$sessions = rows($conn, "SELECT DISTINCT session FROM data_tables WHERE session IS NOT NULL ORDER BY session");
$cashiers = rows($conn, "SELECT DISTINCT cashier FROM ($ledger) l WHERE cashier IS NOT NULL AND cashier <> '' ORDER BY cashier");

/* Daily chart (up to 62 days) */
$chart = [];
$peak = 1;
$span = (strtotime($f['date_to']) - strtotime($f['date_from'])) / 86400 + 1;
if ($span >= 1 && $span <= 62) {
    $by = [];
    foreach (
        rows($conn, "SELECT DATE(ts) AS d, SUM(grad) AS g, SUM(CASE WHEN kind='payment' THEN extra END) AS x,
            SUM(CASE WHEN kind='extra' THEN extra END) AS l FROM ($filtered) x GROUP BY d", $P) as $r
    ) {
        $by[$r['d']] = $r;
    }
    for ($t = strtotime($f['date_from']); $t <= strtotime($f['date_to']); $t += 86400) {
        $d = date('Y-m-d', $t);
        $r = $by[$d] ?? [];
        $chart[] = ['d' => $d, 'g' => (float) ($r['g'] ?? 0), 'x' => (float) ($r['x'] ?? 0), 'l' => (float) ($r['l'] ?? 0)];
    }
    $peak = max(1, ...array_map(fn($c) => $c['g'] + $c['x'] + $c['l'], $chart));
}

$h = fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$rs = fn($n) => number_format((float) $n);
$qs = fn(array $o = []) => http_build_query(array_filter(array_merge(['view' => $view], $f, $o), fn($v) => $v !== ''));
$today = date('Y-m-d');
$ranges = ['Today' => [$today, $today], '7 days' => [date('Y-m-d', strtotime('-6 days')), $today], 'This month' => [date('Y-m-01'), $today], 'All' => ['2020-01-01', $today]];
$labels = ['program' => 'Program', 'session' => 'Session', 'cashier' => 'Taken by', 'search' => 'Search'];
$active = [];
foreach ($labels as $k => $l) {
    if ($f[$k] !== '') {
        $active[] = [$l . ': ' . $f[$k], $k];
    }
}
if ($f['type'] !== '') {
    $active[] = ['Entry: ' . ($f['type'] === 'payment' ? 'payments' : 'extra tickets'), 'type'];
}
if ($f['min'] !== '' || $f['max'] !== '') {
    $active[] = ['Amount: Rs. ' . ($f['min'] !== '' ? $rs($f['min']) : '0') . ' to ' . ($f['max'] !== '' ? $rs($f['max']) : 'any'), 'min', 'max'];
}
if ($f['tickets'] !== '') {
    $active[] = ['Tickets: ' . $f['tickets'], 'tickets'];
}
$adv = $f['type'] !== '' || $f['cashier'] !== '' || $f['min'] !== '' || $f['max'] !== '' || $f['tickets'] !== '' || $f['sort'] !== '';
include("includes/header.php");
