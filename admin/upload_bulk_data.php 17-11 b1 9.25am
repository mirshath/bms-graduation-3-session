<?php
session_start();
include("../database/connection.php");

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $programName = $_POST['program_name'];
    $sessionTime = $_POST['session_time'] ?? null; // get session_time from form
    $file = $_FILES['bulk_file']['tmp_name'];

    if (empty($programName) || empty($file)) {
        echo "<script>alert('Please select a program and upload a valid file!'); window.history.back();</script>";
        exit;
    }

    $ext = pathinfo($_FILES['bulk_file']['name'], PATHINFO_EXTENSION);
    if (strtolower($ext) !== 'csv') {
        echo "<script>alert('Please upload a CSV file only!'); window.history.back();</script>";
        exit;
    }

    $insertCount = 0;
    $skipCount = 0;
    $skippedIDs = [];

    $handle = fopen($file, "r");
    if ($handle !== FALSE) {
        $isHeader = true;
        while (($data = fgetcsv($handle, 1000, ",")) !== FALSE) {
            if ($isHeader) {
                $isHeader = false;
                continue;
            }

            $student_id = trim($data[0]);
            $seat_no = trim($data[1]);

            if (!empty($student_id) && !empty($seat_no)) {

                // Check if already exists
                $check = $conn->prepare("SELECT id FROM bulk_data_table WHERE student_id = ? AND program_name = ?");
                $check->bind_param("ss", $student_id, $programName);
                $check->execute();
                $check->store_result();

                if ($check->num_rows > 0) {
                    $skipCount++;
                    $skippedIDs[] = $student_id;
                    continue;
                }

                // Insert new record with session_time
                $stmt = $conn->prepare("INSERT INTO bulk_data_table (student_id, seat_no, program_name, session_time) VALUES (?, ?, ?, ?)");
                $stmt->bind_param("ssss", $student_id, $seat_no, $programName, $sessionTime);
                $stmt->execute();
                $insertCount++;
            }
        }
        fclose($handle);
    }

    $msg = "Uploaded successfully!\n\nInserted: $insertCount record(s)";
    if ($skipCount > 0) {
        $msg .= "\nSkipped: $skipCount (already existed)\nSkipped IDs: " . implode(", ", $skippedIDs);
    }

    echo "<script>alert(`$msg`); window.location.href='bulk-data.php';</script>";
}
