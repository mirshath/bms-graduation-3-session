<?php
session_start();
include("../database/connection.php");

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $programName = $_POST['program_name'] ?? '';
    $sessionTime = $_POST['session_time'] ?? '';
    $file = $_FILES['bulk_file']['tmp_name'];

    if (empty($programName) || empty($file)) {
        echo "<script>alert('Please select a program and upload a valid file.'); window.history.back();</script>";
        exit;
    }

    $ext = strtolower(pathinfo($_FILES['bulk_file']['name'], PATHINFO_EXTENSION));
    if ($ext !== "csv") {
        echo "<script>alert('Only CSV files are allowed!'); window.history.back();</script>";
        exit;
    }

    $insertCount = 0;
    $skipCount = 0;
    $skippedIDs = [];

    $handle = fopen($file, "r");

    if ($handle !== FALSE) {
        $rowNumber = 0;

        while (($data = fgetcsv($handle, 1000, ",")) !== FALSE) {
            $rowNumber++;

            // Skip header
            if ($rowNumber == 1) continue;

            // NEW: Reading 3 columns
            $student_id = trim($data[0] ?? '');
            $seat_no = trim($data[1] ?? '');
            $student_result = trim($data[2] ?? ''); // NEW COLUMN

            if ($student_id === "" || $seat_no === "") {
                continue;
            }

            // Check existing
            $check = $conn->prepare("SELECT id FROM bulk_data_table WHERE student_id=? AND program_name=?");
            $check->bind_param("ss", $student_id, $programName);
            $check->execute();
            $check->store_result();

            if ($check->num_rows > 0) {
                $skipCount++;
                $skippedIDs[] = $student_id;
                continue;
            }

            // NEW: Insert student_result also
            $stmt = $conn->prepare("
                INSERT INTO bulk_data_table 
                (student_id, seat_no, program_name, session_time, student_result) 
                VALUES (?, ?, ?, ?, ?)
            ");
            $stmt->bind_param("sssss", $student_id, $seat_no, $programName, $sessionTime, $student_result);
            $stmt->execute();

            $insertCount++;
        }

        fclose($handle);
    }

    // Prepare message
    $msg = "Upload Completed!\nInserted: $insertCount";

    if ($skipCount > 0) {
        $msg .= "\nSkipped: $skipCount\nIDs: " . implode(", ", $skippedIDs);
    }

    echo "<script>alert(" . json_encode($msg) . "); window.location.href='bulk-data.php';</script>";
}
