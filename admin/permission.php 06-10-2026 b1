<script>
    (function() {
        var form = document.getElementById('permForm');
        if (!form) return;

        var checks = form.querySelectorAll('.page-check');
        var counter = document.getElementById('pmCount');

        function refresh() {
            var n = 0;
            checks.forEach(function(c) {
                if (c.checked) n++;
            });
            counter.textContent = n + ' of ' + checks.length + ' pages selected';

            form.querySelectorAll('.pm-group').forEach(function(g) {
                var t = g.querySelector('.group-toggle');
                if (!t) return;
                var boxes = g.querySelectorAll('.page-check');
                t.checked = Array.prototype.every.call(boxes, function(b) {
                    return b.checked;
                });
            });
        }

        function setAll(state) {
            checks.forEach(function(c) {
                if (!c.disabled) c.checked = state;
            });
            refresh();
        }

        var all = document.getElementById('checkAll');
        var none = document.getElementById('uncheckAll');
        if (all) all.addEventListener('click', function() {
            setAll(true);
        });
        if (none) none.addEventListener('click', function() {
            setAll(false);
        });

        form.querySelectorAll('.group-toggle').forEach(function(t) {
            t.addEventListener('change', function() {
                t.closest('.pm-group').querySelectorAll('.page-check').forEach(function(b) {
                    if (!b.disabled) b.checked = t.checked;
                });
                refresh();
            });
        });

        checks.forEach(function(c) {
            c.addEventListener('change', refresh);
        });
        refresh();
    })();
</script>

