<script>
    $(document).ready(function() {
        $('#studentSelect').select2({
            placeholder: "Select a student",
            allowClear: true,
            width: '100%'
        });

        $('#extraTicketTable').DataTable();

        let ticketPrice = 0; // global variable for ticket price

        // Load student payment info
        $('#studentSelect').change(function() {
            const studentId = $(this).val();
            if (!studentId) return;

            // Fetch student payment info
            $.ajax({
                url: 'fetch_student_payment.php',
                type: 'POST',
                data: {
                    student_id: studentId
                },
                dataType: 'json',
                success: function(data) {
                    $('#paymentCard').show();

                    $('#programName').text(data.program_name);
                    $('#graduationFee').text(parseFloat(data.graduation_fee).toFixed(2));
                    $('#extraTickets').text(data.extra_ticket_count);
                    $('#extraTicketFee').text(parseFloat(data.extra_ticket_fee).toFixed(2));
                    $('#totalAmount').text(parseFloat(data.total_amount).toFixed(2));

                    // Fetch the price per ticket from data_tables using program_name
                    $.ajax({
                        url: 'fetch_ticket_price.php',
                        type: 'POST',
                        data: {
                            program_name: data.program_name
                        },
                        dataType: 'json',
                        success: function(priceData) {
                            ticketPrice = parseFloat(priceData.extraTicketFee); // Price per ticket
                            $('#ticketPrice').text(ticketPrice.toFixed(2));

                            // Update totalAdded based on number of additional tickets
                            let count = parseInt($('#additionalTickets').val());
                            $('#totalAdded').text((count * ticketPrice).toFixed(2));
                        }
                    });
                }
            });

            // Fetch full payment info and display
            $.ajax({
                url: 'fetch_payment_info.php',
                type: 'POST',
                data: {
                    student_id: studentId
                },
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        $('#student_name').text(response.data.student_name); // <-- NEW
                        $('#program_name').text(response.data.program_name);
                        $('#graduation_fee').text(response.data.graduation_fee);
                        $('#extra_ticket_count').text(response.data.extra_ticket_count);
                        $('#extra_ticket_fee').text(response.data.extra_ticket_fee);
                        $('#total_amount').text(response.data.total_amount);
                        $('#paymentInfo').show();
                    } else {
                        alert('Student not found!');
                        $('#paymentInfo').hide();
                    }
                }
            });
        });

        // Update totalAdded when number of additional tickets changes
        $('#additionalTickets').on('change', function() {
            let count = parseInt($(this).val());
            $('#totalAdded').text((count * ticketPrice).toFixed(2));
        });

        // Add extra ticket
        $('#addExtraTicketBtn').click(function() {
            const studentId = $('#studentSelect').val();
            const addTickets = parseInt($('#additionalTickets').val());

            if (!addTickets || addTickets <= 0) {
                alert('Please enter a valid number of tickets.');
                return;
            }

            $.ajax({
                url: 'update_extra_ticket.php',
                type: 'POST',
                data: {
                    student_id: studentId,
                    addTickets: addTickets,
                    ticketPrice: ticketPrice
                },
                success: function(response) {
                    alert(response);
                    location.reload(); // refresh to show updated info
                }
            });
        });
    });
</script>