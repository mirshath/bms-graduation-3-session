<script>
    (function() {
        var f = document.getElementById('flt'),
            b = document.getElementById('open-f'),
            d = document.getElementById('dr');

        function t(o) {
            f.classList.toggle('open', o);
            b.setAttribute('aria-expanded', o);
            d.inert = !o;
            (o ? d.querySelector('[data-close]') : b).focus();
        }
        b.onclick = function() {
            t(true);
        };
        document.getElementById('scrim').onclick = function() {
            t(false);
        };
        f.querySelector('[data-close]').onclick = function() {
            t(false);
        };
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && f.classList.contains('open')) t(false);
        });
        f.querySelectorAll('[data-find]').forEach(function(i) {
            i.oninput = function() {
                var q = i.value.toLowerCase();
                i.nextElementSibling.querySelectorAll('label').forEach(function(l) {
                    l.hidden = l.textContent.toLowerCase().indexOf(q) < 0;
                });
            };
        });
    })();
</script>
