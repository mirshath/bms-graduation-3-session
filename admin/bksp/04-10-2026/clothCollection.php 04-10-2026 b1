<script>
    $(document).ready(function() {
        let currentStudentID = '';

        // Function to reset form and focus input
        function resetForm() {
            $('#studentIDForm')[0].reset();
            $('#studentID').focus();
            currentStudentID = '';
        }

        function esc(v) {
            return $('<div>').text(v ?? '').html();
        }

        const itemIcons = {
            cloak: 'fas fa-user-graduate',
            slashes: 'fas fa-graduation-cap',
            hats: 'fas fa-graduation-cap'
        };

        const itemNames = {
            cloak: 'Cloak',
            slashes: 'Slashes',
            hats: 'Hat'
        };

        function formatItems(items, studentId) {
            if (!items) {
                return '<div class="alert alert-info text-center mb-0"><i class="fas fa-info-circle me-2"></i>No items assigned</div>';
            }

            let hasItems = false;
            let html = '<div class="mt-3"><h5 class="mb-3 fw-bold text-gray-700">Items Status</h5>';
            html += '<div class="row g-3">';

            ['cloak', 'slashes', 'hats'].forEach(function(item) {
                const data = items[item];
                if (!data || !data.assigned) {
                    return;
                }

                hasItems = true;
                if (!data.collected) {
                    html += `
                        <div class="col-4">
                            <div class="item-card">
                                <div class="item-info">
                                    <div class="item-icon">
                                        <i class="${itemIcons[item]}"></i>
                                    </div>
                                    <div>
                                        <p class="item-name">${itemNames[item]}</p>
                                        <p class="item-status">Pending Issue</p>
                                    </div>
                                </div>
                                <button class="btn btn-success btn-sm markCollectBtn" data-item="${item}" data-student="${esc(studentId)}">
                                    <i class="fas fa-check-circle me-2"></i>Mark as Issued
                                </button>
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <div class="col-4">
                            <div class="item-card collected">
                                <div class="item-info">
                                    <div class="item-icon">
                                        <i class="${itemIcons[item]}"></i>
                                    </div>
                                    <div>
                                        <p class="item-name">${itemNames[item]}</p>
                                        <p class="item-status">Issued Successfully</p>
                                    </div>
                                </div>
                                <span class="collected-badge">
                                    <i class="fas fa-check-circle"></i> Issued
                                </span>
                            </div>
                        </div>
                    `;
                }
            });

            html += '</div>';

            if (!hasItems) {
                html += '<div class="alert alert-info text-center mt-3"><i class="fas fa-info-circle me-2"></i>No items assigned for this student.</div>';
            }

            html += '</div>';
            return html;
        }

        function fetchStudentData(studentID, showModal) {
            $.ajax({
                url: 'checkStudentCloth.php',
                type: 'POST',
                data: {
                    studentID: studentID
                },
                dataType: 'json',
                success: function(response) {
                    if (response.status === 'found') {
                        let studentHtml = `
                            <div class="student-info-card">
                                <div class="student-info-item">
                                    <span class="student-info-label">Student ID:</span>
                                    <span class="student-info-value">${esc(response.student_id)}</span>
                                </div>
                                <div class="student-info-item">
                                    <span class="student-info-label">Name:</span>
                                    <span class="student-info-value">${esc(response.student_name)}</span>
                                </div>
                                <div class="student-info-item">
                                    <span class="student-info-label">Program:</span>
                                    <span class="student-info-value">${esc(response.program)}</span>
                                </div>
                                <div class="student-info-item">
                                    <span class="student-info-label">Session:</span>
                                    <span class="student-info-value">${esc(response.session)}</span>
                                </div>
                            </div>
                        `;
                        $('#studentInfo').html(studentHtml);
                        $('#itemsList').html(formatItems(response.items, response.student_id));
                        if (showModal) {
                            $('#successModal').modal('show');
                        }
                    } else if (response.status === 'not_registered') {
                        $('#notRegisteredModal').modal('show');
                    } else if (response.status === 'not_paid') {
                        $('#notPaidModal').modal('show');
                    } else {
                        $('#errorModal').modal('show');
                    }
                },
                error: function() {
                    alert('An error occurred. Please try again.');
                }
            });
        }

        $('#studentIDForm').on('submit', function(e) {
            e.preventDefault();
            let studentID = $('#studentID').val().trim();
            if (!studentID) return;

            currentStudentID = studentID;
            fetchStudentData(studentID, true);
        });

        $(document).on('click', '.markCollectBtn', function() {
            let studentID = $(this).data('student');
            let item = $(this).data('item');
            let btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Processing...');

            $.ajax({
                url: 'markClothAttended.php',
                type: 'POST',
                data: {
                    studentID: studentID,
                    item: item
                },
                dataType: 'json',
                success: function(response) {
                    if (response.status === 'success') {
                        fetchStudentData(studentID, false);
                    } else {
                        var msg = response.message || 'Failed to mark as issued.';
                        if (response.debug) msg += '\n' + response.debug;
                        alert(msg);
                        btn.prop('disabled', false).html('<i class="fas fa-check-circle me-2"></i>Mark as Issued');
                    }
                },
                error: function(xhr) {
                    var msg = 'An error occurred. Please try again.';
                    try {
                        var r = typeof xhr.responseText === 'string' && xhr.responseText ? JSON.parse(xhr.responseText) : {};
                        if (r.message) msg = r.message;
                        if (r.debug) msg += '\n' + r.debug;
                    } catch (e) {}
                    alert(msg);
                    btn.prop('disabled', false).html('<i class="fas fa-check-circle me-2"></i>Mark as Issued');
                }
            });
        });

        // Reset form when modals are closed
        $('.modal').on('hidden.bs.modal', function() {
            resetForm();
        });

        // Auto-focus input on page load
        $('#studentID').focus();

        // Clear input on escape key
        $(document).on('keydown', function(e) {
            if (e.key === 'Escape') {
                if ($('.modal').hasClass('show')) {
                    return; // Let modal handle escape
                }
                resetForm();
            }
        });


    });
</script>

