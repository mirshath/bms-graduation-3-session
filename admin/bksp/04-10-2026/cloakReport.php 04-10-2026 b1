<script>
    $(function() {
        if ($('#collectionsTable').length) {
            $('#collectionsTable').DataTable({
                pageLength: 500,
                lengthMenu: [
                    [50, 100, 250, 500, -1],
                    [50, 100, 250, 500, "All"]
                ],
                order: [
                    [5, 'desc']
                ]
            });
        }

        // "Didn't get cloak" mode tables
        if ($('#programSummaryTable').length) {
            $('#programSummaryTable').DataTable({
                pageLength: 50,
                order: [
                    [6, 'desc']
                ] // most missing first
            });
        }
        if ($('#missingTable').length) {
            $('#missingTable').DataTable({
                pageLength: 500,
                lengthMenu: [
                    [50, 100, 250, 500, -1],
                    [50, 100, 250, 500, "All"]
                ],
                order: [
                    [2, 'asc'],
                    [0, 'asc']
                ] // program, then student id
            });
        }

        $('.select2, .select2-filter').select2({
            width: '100%'
        });

        // Auto-submit filters on any change
        $('#program, #return_status').on('change', function() {
            $('#filterForm')[0].submit();
        });
        // Changing the session reloads the Program list with only that session's programs
        $('#session').on('change', function() {
            $('#program').val('');
            $('#filterForm')[0].submit();
        });
        // Return-status doesn't apply to the "didn't get cloak" check, so clear it
        $('#issue_status').on('change', function() {
            if ($(this).val() !== '') {
                $('#return_status').val('');
            }
            $('#filterForm')[0].submit();
        });

        // CSV export for the "didn't get cloak" list (respects search + sort)
        $('#exportMissingCsv').on('click', function() {
            var table = $('#missingTable').DataTable();
            var rows = [];
            var head = [];
            $('#missingTable thead th').each(function() {
                head.push($(this).text().trim());
            });
            rows.push(head);

            table.rows({
                search: 'applied',
                order: 'applied'
            }).nodes().each(function(tr) {
                var r = [];
                $(tr).children('td').each(function() {
                    var badges = $(this).find('.badge');
                    if (badges.length > 1) {
                        r.push(badges.map(function() {
                            return $(this).text().trim();
                        }).get().join(', '));
                    } else {
                        r.push($(this).text().replace(/\s+/g, ' ').trim());
                    }
                });
                rows.push(r);
            });

            var csv = rows.map(function(r) {
                return r.map(function(v) {
                    return '"' + String(v).replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\r\n');

            var blob = new Blob(['\uFEFF' + csv], {
                type: 'text/csv;charset=utf-8;'
            });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'cloak_not_issued_report.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        });
    });
</script>