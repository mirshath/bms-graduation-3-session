<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function() {
        $('body').addClass('scan-page');

        const sidebarOverlay = $('#sidebarOverlay');

        $('#sidebarToggleMobile').on('click', function() {
            $('body').toggleClass('sidebar-open');
        });

        sidebarOverlay.on('click', function() {
            $('body').removeClass('sidebar-open');
        });

        // Store student data (kept for receipt printing)
        let currentStudentData = null;

        // Escape text before putting it into HTML
        function esc(v) {
            return $('<div>').text(v ?? '').html();
        }

        function sessionLabel(v) {
            v = String(v ?? '').trim();
            if (!v) return '—';
            return v.replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, function(c) {
                return c.toUpperCase();
            });
        }

        function initials(name) {
            const w = String(name ?? '').trim().split(/\s+/).filter(Boolean);
            if (!w.length) return '?';
            return (w[0][0] + (w.length > 1 ? w[w.length - 1][0] : '')).toUpperCase();
        }

        function payTag(status) {
            const raw = String(status ?? '').trim();
            if (raw.toLowerCase() === 'paid') {
                return '<span class="sc-tag ok"><i class="fas fa-check-circle" aria-hidden="true"></i> Paid</span>';
            }
            return '<span class="sc-tag warn"><i class="fas fa-exclamation-circle" aria-hidden="true"></i> ' + esc(raw || 'Not completed') + '</span>';
        }

        // One student summary used by both the "found" and "already attended" modals
        function studentCard(d, clothId) {
            const seat = String(d.seat_no ?? '').trim();
            return `
                <div class="sc-who">
                    <span class="sc-ini">${esc(initials(d.full_name))}</span>
                    <div>
                        <strong>${esc(d.full_name)}</strong>
                        <div class="sc-meta">
                            <span class="id">${esc(d.student_id)}</span>
                            ${payTag(d.graduation_payment_status)}
                        </div>
                    </div>
                </div>
                <div class="sc-prog">
                    <span class="sc-k">Programme</span>
                    <b>${esc(d.program_name)}</b>
                </div>
                <div class="sc-seat">
                    <div class="main"><span class="sc-k">Seat no</span><span class="sc-seatno">${seat ? esc(seat) : '—'}</span></div>
                    <div><span class="sc-k">Session</span><b>${esc(sessionLabel(d.session))}</b></div>
                </div>
                <div class="sc-cloth">
                    <span class="sc-k">Clothing</span>
                    <div id="${clothId}"></div>
                </div>`;
        }

        // Load clothing status (required in data_tables vs collected in clothing_collections)
        function loadClothing(studentID, $target) {
            $target.html('<div class="sc-skel" role="status" aria-label="Checking clothing"></div>');

            $.ajax({
                url: 'check_clothing.php',
                type: 'POST',
                dataType: 'json',
                data: {
                    studentID
                },
                success: function(c) {
                    if (c.status !== 'success') {
                        $target.html('<p class="sc-note bad"><i class="fas fa-exclamation-circle" aria-hidden="true"></i> Could not check clothing.</p>');
                        return;
                    }

                    if (!c.required || c.required.length === 0) {
                        $target.html('<p class="sc-note muted">No clothing required for this programme.</p>');
                        return;
                    }

                    const chip = function(t, ok) {
                        return '<span class="sc-chip ' + (ok ? 'ok' : 'bad') + '"><i class="fas ' + (ok ? 'fa-check' : 'fa-times') + '" aria-hidden="true"></i> ' + esc(t) + '</span>';
                    };

                    let html = '<div class="sc-chips">';
                    (c.collected || []).forEach(function(t) {
                        html += chip(t, true);
                    });
                    (c.missing || []).forEach(function(t) {
                        html += chip(t, false);
                    });
                    html += '</div>';

                    if (c.missing && c.missing.length > 0) {
                        html += '<p class="sc-note bad"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i> Pending to collect: ' + esc(c.missing.join(', ')) + '</p>';
                    } else {
                        html += '<p class="sc-note ok"><i class="fas fa-check-circle" aria-hidden="true"></i> All required clothing collected</p>';
                    }

                    $target.html(html);
                },
                error: function() {
                    $target.html('<p class="sc-note bad"><i class="fas fa-exclamation-circle" aria-hidden="true"></i> Clothing check failed.</p>');
                }
            });
        }

        // Error modal (not found / server error)
        function showError(title, text, id) {
            $('#errorTitle').text(title);
            $('#errorText').text(text);
            $('#errorId').text(id || '').toggle(!!id);
            $('#errorModal').modal('show');
        }

        // Small confirmation toast
        let toastTimer;

        function toast(msg) {
            const $t = $('#scToast');
            $t.find('span').text(msg);
            $t.addClass('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function() {
                $t.removeClass('show');
            }, 3500);
        }

        const $studentID = $('#studentID');
        const $studentForm = $('#studentIDForm');
        const $goBtn = $('#goBtn');
        let busy = false;

        function setBusy(b) {
            busy = b;
            $goBtn.prop('disabled', b).find('span').text(b ? 'Checking…' : 'Check student');
        }

        // Focus input on page load
        $studentID.focus();

        // Reset input and focus when any modal is hidden
        $('#successModal, #errorModal, #attendedModal').on('hidden.bs.modal', function() {
            $studentID.val('').focus();
        });

        // Fresh state every time the "found" modal opens
        $('#successModal').on('show.bs.modal', function() {
            $('#markErr').prop('hidden', true).text('');
            $('#attendedBtn').prop('disabled', false).find('span').text('Mark as attended');
        });

        // Handle form submission (manual input, scanner or Enter key)
        $studentForm.on('submit', function(e) {
            e.preventDefault();

            const studentID = $studentID.val().trim();
            if (!studentID || busy) return;

            setBusy(true);

            $.ajax({
                url: 'check_student.php',
                type: 'POST',
                dataType: 'json',
                data: {
                    studentID
                },

                success: function(res) {

                    if (res.status === 'success') {
                        // Store student data for receipt printing
                        window.lastStudentCheck = res.data;
                        currentStudentData = res.data;

                        $('#studentInfo').html(studentCard(res.data, 'clothingInfoSuccess'));
                        loadClothing(res.data.student_id, $('#clothingInfoSuccess'));
                        $('#successModal').modal('show');

                    } else if (res.status === 'attended') {
                        $('#attendedInfo').html(studentCard(res.data, 'clothingInfoAttended'));
                        loadClothing(res.data.student_id, $('#clothingInfoAttended'));
                        $('#attendedModal').modal('show');

                    } else {
                        showError('Student not found', 'Please check the ID and try again.', studentID);
                    }
                },

                error: function() {
                    showError('Server error', 'Could not reach the server. Please try again.');
                },

                complete: function() {
                    setBusy(false);
                }
            });
        });

        // (Enter already submits the form, so no extra keypress handler is needed)

        // Update one session card (numbers + progress bar)
        function setSession(prefix, d) {
            d = d || {};
            const paid = parseInt(d.paid, 10) || 0;
            const att = parseInt(d.attended, 10) || 0;
            const rem = parseInt(d.remaining, 10) || 0;
            const pct = paid > 0 ? Math.min(100, Math.round(att / paid * 100)) : 0;

            $('#' + prefix + 'Paid').text(paid);
            $('#' + prefix + 'Attended').text(att);
            $('#' + prefix + 'Remaining').text(rem);
            $('#' + prefix + 'Pct').text(pct + '%');
            $('#' + prefix + 'Bar').css('width', pct + '%').parent().attr('aria-valuenow', pct);
        }

        // Function to update session stats in real-time
        function updateSessionStats() {
            $.ajax({
                url: 'fetch_session_stats.php',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    if (data.status === 'success') {
                        setSession('session_01', data.session_01);
                        setSession('session_02', data.session_02);
                        setSession('session_03', data.session_03);
                    }
                },
                error: function() {
                    console.log('Error updating session stats');
                }
            });
        }

        // Auto-refresh stats every 5 seconds
        setInterval(updateSessionStats, 5000);

        // Handle "Mark as Attended" button click
        $(document).on('click', '#attendedBtn', function() {
            const $btn = $(this);
            const studentID = $('#studentID').val().trim();
            if (!studentID || $btn.prop('disabled')) return;

            function fail(msg) {
                $('#markErr').text(msg || 'Could not mark attendance.').prop('hidden', false);
                $btn.prop('disabled', false).find('span').text('Mark as attended');
            }

            $('#markErr').prop('hidden', true);
            $btn.prop('disabled', true).find('span').text('Marking…');

            $.ajax({
                url: 'mark_attended.php',
                type: 'POST',
                data: {
                    studentID
                },
                success: function(response) {
                    let res;
                    try {
                        res = (typeof response === 'string') ? JSON.parse(response) : response;
                    } catch (e) {
                        res = {
                            status: 'error',
                            message: 'Unexpected response from the server.'
                        };
                    }

                    if (res && res.status === 'success') {
                        $('#successModal').modal('hide');
                        toast('Attendance marked for ' + ((currentStudentData && currentStudentData.full_name) || studentID));

                        // Update stats immediately after marking attendance
                        setTimeout(function() {
                            updateSessionStats();
                        }, 500);
                    } else {
                        fail(res && res.message);
                    }
                },
                error: function() {
                    fail('Server error. Please try again.');
                }
            });
        });

        // Print receipt function for 72mm thermal printer - Direct print without preview
        function printReceipt(studentData) {
            // Create receipt content
            const receiptContent = `
                <div class="receipt-container">
                    <div class="receipt-header">
                        <h2>BMS GRADUATION 2026</h2>
                        <hr>
                    </div>
                    <div class="receipt-body">
                        <p><strong>Student ID:</strong> ${studentData.student_id}</p>
                        <p><strong>Name:</strong> ${studentData.full_name}</p>
                        <hr>
                        <h1 class="seat-number">SEAT NO: ${studentData.seat_no}</h1>
                        <h3 class="in-number"><strong>IN NO:</strong> ${studentData.in_no || 'N/A'}</h3>
                        <p><strong>Session:</strong> ${studentData.session}</p>
                        <hr>
                        <p class="timestamp">Date: ${new Date().toLocaleString()}</p>
                        <p class="footer">Thank you for attending!</p>
                    </div>
                </div>
            `;

            // Create hidden iframe for printing
            const iframe = document.createElement('iframe');
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            iframe.style.opacity = '0';
            iframe.style.pointerEvents = 'none';
            document.body.appendChild(iframe);

            const iframeDoc = iframe.contentWindow.document;
            iframeDoc.open();
            iframeDoc.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Print Receipt</title>
                    <style>
                        @media print {
                            @page {
                                size: 72mm auto;
                                margin: 0;
                            }
                            * {
                                -webkit-print-color-adjust: exact;
                                print-color-adjust: exact;
                            }
                            body {
                                margin: 0;
                                padding: 5mm 3mm;
                                font-family: 'Courier New', monospace;
                                font-size: 11px;
                                width: 72mm;
                                line-height: 1.3;
                            }
                        }
                        body {
                            margin: 0;
                            padding: 5mm 3mm;
                            font-family: 'Courier New', monospace;
                            font-size: 11px;
                            width: 72mm;
                            line-height: 1.3;
                        }
                        .receipt-container {
                            width: 100%;
                            text-align: center;
                        }
                        .receipt-header h2 {
                            font-size: 14px;
                            font-weight: bold;
                            margin: 4px 0;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                        }
                        .receipt-header p {
                            font-size: 10px;
                            margin: 2px 0;
                        }
                        .receipt-body {
                            text-align: left;
                            margin-top: 8px;
                        }
                        .receipt-body p {
                            margin: 4px 0;
                            font-size: 10px;
                            word-wrap: break-word;
                        }
                        .receipt-body strong {
                            font-weight: bold;
                        }
                        .seat-number {
                            text-align: center;
                            font-size: 25px;
                            font-weight: bold;
                            margin: 8px 0;
                            color: #000;
                            text-transform: uppercase;
                        }
                        .in-number {
                            text-align: center;
                            font-size: 16px;
                            font-weight: bold;
                            margin: 8px 0;
                            color: #000;
                        }
                        .in-number strong {
                            font-weight: bold;
                        }
                        hr {
                            border: none;
                            border-top: 1px dashed #000;
                            margin: 6px 0;
                        }
                        .timestamp {
                            text-align: center;
                            font-size: 9px;
                            margin-top: 8px;
                        }
                        .footer {
                            text-align: center;
                            font-size: 10px;
                            font-weight: bold;
                            margin-top: 8px;
                        }
                    </style>
                </head>
                <body>
                    ${receiptContent}
                </body>
                </html>
            `);
            iframeDoc.close();

            // Wait for content to load, then print directly
            setTimeout(function() {
                try {
                    iframe.contentWindow.focus();
                    iframe.contentWindow.print();

                    // Remove iframe after printing (with delay to ensure print completes)
                    setTimeout(function() {
                        document.body.removeChild(iframe);
                    }, 1000);
                } catch (e) {
                    console.error('Print error:', e);
                    // Fallback: remove iframe if print fails
                    document.body.removeChild(iframe);
                }
            }, 300);
        }

    });
</script>

